# URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Credenciales públicas de Supabase (seguras para el cliente con RLS activo)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Clave pública VAPID para Web Push (opcional en local; autogenerada por pnpm env:setup)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# EXCLUSIVO SERVIDOR — NUNCA EXPONER CON PREFIJO NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-project-service-role-key
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@pedidosflash.local
